FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# Install lightweight deps (skip transkun — it pulls in ~2GB of PyTorch)
RUN grep -v '^transkun' requirements.txt | pip install --no-cache-dir -r /dev/stdin
# Install transkun without deps so the module exists; transcription needs torch (not included)
RUN pip install --no-cache-dir transkun --no-deps

CMD ["bash", "/app/entrypoint.sh"]
